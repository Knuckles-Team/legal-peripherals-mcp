# Tool Suite Toggles
SOSTOOL=True
EINTOOL=True
STATUTETOOL=True
COMPLIANCETOOL=True
INGESTTOOL=True

# Native KG ingest of looked-up entities (false disables it)
LEGAL_KG_INGEST=true

# Analyzer scripts directory for run_enhancer.py (optional)
# CODE_ENHANCER_SCRIPTS_DIR=

# IRS EIN API hours simulation override (optional, True to bypass hours restriction in dev)
BYPASS_IRS_FILING_HOURS=False

# EIN draft request timeout in seconds
EIN_TIMEOUT_SECONDS=30

# Secretary of State entity lookup (OpenCorporates company registry)
SOS_TIMEOUT_SECONDS=30
OPENCORPORATES_API_TOKEN=
OPENCORPORATES_BASE_URL=https://api.opencorporates.com/v0.4

# Statute / charter lookup request timeout in seconds
STATUTE_TIMEOUT_SECONDS=30

# API Client Connection Configuration
LEGAL_PERIPHERALS_BASE_URL=http://localhost:8000
LEGAL_PERIPHERALS_TOKEN=
